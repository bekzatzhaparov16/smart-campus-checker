    {"id":"AC4-overlap-inside", "desc":"fully inside a booking",               "start":"10:15","end":"10:45","available":false,"code":"OVERLAP"},
    {"id":"AC4-overlap-around", "desc":"encloses a booking",                   "start":"09:30","end":"11:30","available":false,"code":"OVERLAP"},
    {"id":"AC4-touch-after",    "desc":"touching: starts exactly at booking end","start":"11:00","end":"12:00","available":true,"code":"OK"},
    {"id":"AC4-touch-before",   "desc":"touching: ends exactly at booking start","start":"09:00","end":"10:00","available":true,"code":"OK"}
  ]
