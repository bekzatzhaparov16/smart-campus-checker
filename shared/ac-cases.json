    {"id":"AC1-bad-text",       "desc":"non-time text is invalid",             "start":"abc",  "end":"11:00","available":false,"code":"INVALID_FORMAT"},
    {"id":"AC1-end-before",     "desc":"end before start",                     "start":"12:00","end":"11:00","available":false,"code":"END_BEFORE_START"},
